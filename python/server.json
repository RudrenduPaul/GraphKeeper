{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/graphkeeper",
  "description": "Mines git history for file co-change patterns into a queryable knowledge graph via MCP.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/GraphKeeper",
    "source": "github"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "graphkeeper-cli",
      "version": "0.1.5",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "graphkeeper-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "graphkeeper-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
